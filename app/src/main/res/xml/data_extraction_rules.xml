<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de extracción (Android 12+). Ver
   https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Auditoría Semana 2 / Paso 3 (LGPDPPSO + OWASP MASVS-STORAGE):
   la base Room `cronobus.db` contiene geolocalización laboral, bitácoras de turno y evidencia de
   apelaciones. No debe copiarse a Google Drive ni a otro dispositivo: su única salida legítima es
   el Store & Forward hacia el backend del operador.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
