# ==========================================
# CronoBus - .gitignore
# ==========================================

# --- Gradle & Build Outputs ---
.gradle/
build/
*/build/
app/build/
.kotlin/
.cxx/
.externalNativeBuild/
captures/
*.apk
*.aab
*.ap_

# --- Android Studio / IntelliJ IDEA ---
*.iml
.idea/
*.ipr
*.iws
out/

# --- Local & Sensitive Configurations ---
local.properties
.env
.env.local
.env.*.local
!.env.example
secrets.xml
google-services.json

# --- Signing & Keystores ---
*.jks
*.keystore
debug.keystore

# --- VS Code ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --- OS Specific Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# --- Office / Microsoft Temp Files (Word, Excel) ---
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp

# --- Node / Web Packages & Logs (si se agregan herramientas JS) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.dist/
